# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Circle API Configuration
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_ENTITY_PUBLIC_KEY=
CIRCLE_WALLET_SET_ID=
CIRCLE_WALLET_BLOCKCHAINS=ARC-TESTNET
CIRCLE_WALLET_ACCOUNT_TYPE=SCA
CIRCLE_WALLET_COUNT=1
CIRCLE_BASE_URL=https://api.circle.com
CIRCLE_WEBHOOK_SECRET= # can be empty

# Smart Contract Addresses (fill after deploy contracts)
# AILA_VAULT_ADDRESS=0x...
# LIQUIDITY_BUFFER_ADDRESS=0x...
# YIELD_ALLOCATOR_ADDRESS=0x...
# Arc Blockchain Configuration
# ARC_RPC_URL=https://testnet.arc.network/rpc
# ARC_CHAIN_ID=12345

# Only if you need to call contracts directly from backend
# DEPLOYER_PRIVATE_KEY=your_deployer_private_key

# AI Service Configuration
# Cloudflare Workers AI (STT)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenAI for (Intent Parsing, Explanations, Reasoning)
OPENAI_API_KEY=

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Redis Configuration (for queues), If deploying on Replit, Redis is available automatically
UPSTASH_REDIS_URL=

# Database (Managed PostgreSQL on Supabase for ledger)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

API_RATE_LIMIT=100

# Logging
LOG_LEVEL=debug




# Deployer Wallet (NEVER commit the real .env file!)
PRIVATE_KEY= 
ARC_PRIVATE_KEY= # same as PRIVATE_KEY

# Arc Testnet Configuration
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_RPC_URL=https://rpc.testnet.arc.network

DEPLOYER_ADDRESS=

# USDC Contract on Arc Testnet
USDC_ADDRESS=
ARC_USDC_ADDRESS= # same as USDC_ADDRESS

# Deployed AilaBank Contracts (Arc Testnet)
AILA_VAULT_ADDRESS=
ARC_VAULT_ADDRESS= # same as AILA_VAULT_ADDRESS

LIQUIDITY_BUFFER_ADDRESS=
ARC_BUFFER_ADDRESS= # same as LIQUIDITY_BUFFER_ADDRESS

YIELD_ALLOCATOR_ADDRESS=
ARC_YIELD_ALLOCATOR_ADDRESS= # same as YIELD_ALLOCATOR_ADDRESS

# Deployment Info
NETWORK=arc-testnet
CHAIN_ID=
EXPLORER_URL=https://testnet.arcscan.app


EXCHANGERATE_API_KEY=